APP_ENV=development
LOG_LEVEL=INFO

# Replace this value outside local development. Never commit a real token.
AI_INTERNAL_TOKEN=replace-with-a-long-random-service-token

LLM_PROVIDER=ollama
# Use LLM_PROVIDER=fake for local/API smoke tests without Ollama or model weights.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_CONTINUE_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=60

