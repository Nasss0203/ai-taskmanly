APP_ENV=development
LOG_LEVEL=INFO

# Required in development AND production. This placeholder is rejected.
# Use >=32 random bytes encoded as hex/base64url; never commit a real token.
# NestJS (be-task-management) must use the same value.
AI_INTERNAL_TOKEN=replace-with-a-long-random-service-token

LLM_PROVIDER=ollama
# Use LLM_PROVIDER=fake for local/API smoke tests without Ollama or model weights.
OLLAMA_BASE_URL=http://localhost:11434

# Default model: intent, page intent and writing (except CONTINUE).
OLLAMA_MODEL=qwen3:1.7b
# Optional per-feature models; each falls back to OLLAMA_MODEL when unset.
OLLAMA_CONTINUE_MODEL=qwen3:4b-instruct
OLLAMA_PAGE_COMPOSITION_MODEL=qwen3:4b-instruct
# Falls back to OLLAMA_PAGE_COMPOSITION_MODEL, then OLLAMA_MODEL.
OLLAMA_MODIFICATION_PLANNER_MODEL=qwen3:4b-instruct
# Intent + page-intent; unset keeps OLLAMA_MODEL. Naming the planner's model
# shares its loaded copy (one model on a 4 GB GPU). Measured 2026-11-05:
# page-intent on qwen3:1.7b CPU took ~71% of an Ask.
# OLLAMA_INTENT_MODEL=qwen3:4b-instruct

# Context window; 6144 fits a 4 GB GPU (code default 16384).
OLLAMA_NUM_CTX=6144
# Optional: layers offloaded to GPU (empty = Ollama decides).
# OLLAMA_NUM_GPU=
# OLLAMA_MODIFICATION_PLANNER_NUM_GPU=8

# Replies are streamed. TIMEOUT caps the whole request: a new page on a
# 4b model that runs partly on the CPU takes up to about three minutes. Keep
# it below the backend's AI_SERVICE_TIMEOUT_MS (270 s), which stays below the
# frontend's Ask timeout (300 s). IDLE_TIMEOUT fails a model that sends
# nothing for that long.
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_IDLE_TIMEOUT_SECONDS=60

# M5: Page text vectors. num_gpu 0 keeps the embedding model on the CPU so
# the chat model keeps the GPU.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_NUM_GPU=0
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=60

# GPU layers per model, for every job that calls it (JSON). On a 4 GB GPU, put
# the planner model wholly on the GPU and the small intent model on the CPU, so
# no model is split between the GPU and system RAM. Ollama itself also needs
# OLLAMA_FLASH_ATTENTION=1 and OLLAMA_KV_CACHE_TYPE=q8_0 (see README).
# OLLAMA_MODEL_NUM_GPU={"qwen3:1.7b": 0, "qwen3:4b-instruct": 99}
